# Copy to .env and fill in. Loaded by Next.js, the Python data-api, and the
# node scripts (all three read the repo-root .env).

# ── Database ────────────────────────────────────────────────────────────────
# One URL points the ENTIRE stack (frontend, data-api, scripts) at a database.
# Leave unset for local dev (defaults to mysql://incighder:password@127.0.0.1:3306/incighder).
# For a free hosted MySQL (TiDB Serverless, Aiven, ...) paste their URL and keep
# ?sslmode=require (or add DB_SSL=true) — hosted MySQL requires TLS.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:4000/incighder?sslmode=require

# Individual overrides (only used where DATABASE_URL doesn't specify them):
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=incighder
# DB_PASSWORD=password
# DB_NAME=incighder
# DB_SSL=true            # force TLS without putting it in the URL
# DB_SSL_CA=/path/to/ca.pem  # custom CA bundle (defaults to certifi's)

# ── Ports / service URLs ────────────────────────────────────────────────────
# DATA_API_PORT=5050     # Flask data-api port (start_dev.sh + frontend default)
# WEB_PORT=3000          # Next.js dev port (start_dev.sh)
# DATA_API_URL=          # full URL to the data-api if it isn't on localhost
                         # (e.g. a cloudflared tunnel URL, set this in Vercel)

# ── API keys ────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=
GOOGLE_AI_API_KEY=
LAST_FM_API_KEY=
LAST_FM_SHARED_SECRET=
SPOTIFY_SP_DC=
SCRAPINGBEE_API_KEY=
SCRAPE_DO_TOKEN=

# ── Admin gate (see /login) ─────────────────────────────────────────────────
# Comma-separated passphrases that unlock admin mode (one per trusted human).
ADMIN_PASSWORDS=
# Random secret for signing the admin session cookie (openssl rand -hex 32).
AUTH_SECRET=
# Shared secret between the Next proxies and the (tunneled) data-api.
DATA_API_SECRET=

# ── GLO agent (/api/agent) ───────────────────────────────────────────────
# Anthropic is preferred; falls back to GOOGLE_AI_API_KEY (above) if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Force a provider (cli | anthropic | gemini); cli uses your logged-in Claude
# Code subscription — local only. GLO_CLI_MODEL defaults to 'sonnet'.
GLO_PROVIDER=
GLO_CLI_MODEL=
# Spoken replies: Gemini TTS voice/style/model (defaults: Despina — a poised
# British woman, natural and warm — on gemini-2.5-flash-preview-tts).
GLO_TTS_VOICE=
GLO_TTS_STYLE=
GLO_TTS_MODEL=
